# Optional but recommended for actual OCR and multimodal receipt analysis.
# Local runs: copy this file to `.env` and fill in the value.
# Vercel: Project Settings -> Environment Variables -> add GEMINI_API_KEY
#         (tick Production + Preview + Development), then REDEPLOY the project.
#         Env var changes only apply to new deployments.
# Use the exact name GEMINI_API_KEY — a VITE_ prefixed variable is exposed to the
# browser and is NOT readable by the serverless function.
# Verify after deploying: GET /api/health -> "geminiConfigured": true
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
